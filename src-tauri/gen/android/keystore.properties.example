# Felldl Android 签名配置（复制为 keystore.properties 后填写）
#
# 该文件必须保持私有：keystore.properties 与 .jks 均已在 .gitignore 中，
# 不要提交到 Git、不要写进日志、不要贴到 issue/聊天。
#
# 相对路径以 src-tauri/gen/android 为根目录解析。
storeFile=keystore/felldl-release.jks
storePassword=<你的密钥库口令>
keyAlias=felldl
keyPassword=<你的私钥口令>
#
# 也可以不建此文件，改用环境变量：
#   FELLDL_KEYSTORE_FILE / FELLDL_KEYSTORE_PASSWORD / FELLDL_KEY_ALIAS / FELLDL_KEY_PASSWORD
# 适合 CI：口令放 CI secret，构建时注入，仓库里不出现任何凭据。
